<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_student_management" model="ir.module.category">
        <field name="name">Student Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_student_management" model="res.groups.privilege">
        <field name="name">Access Level</field>
        <field name="category_id" ref="module_category_student_management"/>
        <field name="placeholder">No Access</field>
    </record>

    <!-- Student: can only view records, no edit/create/delete -->
    <record id="group_student_user" model="res.groups">
        <field name="name">Student (Read Only)</field>
        <field name="privilege_id" ref="privilege_student_management"/>
    </record>

    <!-- Teacher: full control - create, edit, delete -->
    <record id="group_student_teacher" model="res.groups">
        <field name="name">Teacher (Full Access)</field>
        <field name="privilege_id" ref="privilege_student_management"/>
        <field name="implied_ids" eval="[(4, ref('group_student_user'))]"/>
    </record>

    <record id="group_student_hod" model="res.groups">

    <field name="name">HOD</field>

    <field name="privilege_id"
           ref="privilege_student_management"/>

    <field name="implied_ids"
           eval="[(4, ref('group_student_teacher'))]"/>

</record>

</odoo>
