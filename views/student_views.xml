<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_student_student_list" model="ir.ui.view">
        <field name="name">student.student.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" width="40"/>
                <field name="name"/>
                <field name="age" readonly="1"/>
                <field name="gender"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'new'"
                    decoration-warning="state == 'confirmed'"
                    decoration-success="state == 'graduated'"/>
            </list>
        </field>
    </record>

    <record id="view_student_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student">

                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'new'"
                            groups="students_management.group_student_teacher"/>
                    <button name="action_graduate" type="object" string="Graduate"
                            class="oe_highlight" invisible="state != 'confirmed'"
                            groups="students_management.group_student_teacher"/>
                    <button name="action_reset_new" type="object" string="Reset to New"
                            invisible="state == 'new'"
                            groups="students_management.group_student_teacher"/>
                    <button name="%(action_assign_department_wizard)d" type="action"
                            string="Assign Department" class="btn-secondary"
                            groups="students_management.group_student_teacher"/>
                    <button name="%(action_send_email_wizard)d" type="action"
                            string="Send Email" class="btn-secondary"
                            groups="students_management.group_student_teacher"/>
                    <button name="%(action_print_confirm_wizard)d" type="action"
                            string="Print" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,confirmed,graduated"/>
                </header>

                <sheet>
                    <div class="oe_avatar">
                        <field name="image" widget="image" class="oe_avatar"
                               options="{'size': [180, 180]}"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group col="3">
                        <group string="Basic Info">
                            <field name="age" readonly="1"/>
                            <field name="gender" required="state == 'confirmed'"/>
                            <field name="dob"/>
                        </group>

                        <group string="Contact Info">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>

                        <group string="Academic Info">
                            <field name="department_id" invisible="state == 'graduated'"/>
                            <field name="subject_ids" widget="many2many_tags"/>
                            <field name="teacher_id"/>
                            <field name="overall_percentage" readonly="1"/>
                            <field name="overall_grade" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Semesters">
                            <field name="semester_fee_ids">
                                <list editable="bottom">
                                    <field name="semester_id"/>
                                    <field name="total_fee" readonly="1"/>
                                    <field name="discount_percent" readonly="1"/>
                                    <field name="discount_amount" readonly="1"/>
                                    <field name="net_fee" readonly="1"/>
                                    <field name="paid_amount"/>
                                    <field name="balance" readonly="1"/>
                                    <field name="payment_status" widget="badge"
                                        decoration-success="payment_status == 'paid'"
                                        decoration-danger="payment_status == 'unpaid'"
                                        decoration-warning="payment_status == 'partial'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Marks">
                            <field name="mark_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="max_mark"/>
                                    <field name="obtained_mark"/>
                                    <field name="percentage" readonly="1"/>
                                    <field name="grade" readonly="1"/>
                                    <field name="result" widget="badge"
                                        decoration-success="result == 'pass'"
                                        decoration-danger="result == 'fail'"/>
                                </list>
                            </field>
                        </page>
                         <page string="Internal Notes">
                            <field name="internal_notes">
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_student_student_kanban" model="ir.ui.view">
        <field name="name">student.student.kanban</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-3 p-2">
                            <field name="image" widget="image" class="oe_kanban_avatar" options="{'size': [48, 48]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted small"><field name="department_id"/></div>
                                <div class="text-muted small"><field name="dob"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_student_management_root" name="Student Management" sequence="10"/>
    <menuitem id="menu_student" name="Students" parent="menu_student_management_root"
              action="student_action" sequence="10"/>

</odoo>
