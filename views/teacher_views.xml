<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View for Teacher -->
    <record id="view_student_teacher_list" model="ir.ui.view">
        <field name="name">student.teacher.list</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers">
                <field name="image" widget="image" width="40"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="student_count"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Form View for Teacher -->
    <record id="view_student_teacher_form" model="ir.ui.view">
        <field name="name">student.teacher.form</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <header>
                    <button name="action_set_active" type="object" string="Set Active"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_set_inactive" type="object" string="Set Inactive"
                            invisible="state == 'inactive'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_avatar">
                        <field name="image" widget="image" class="oe_avatar"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group col="2">
                        <group string="Basic Info">
                            <field name="dob"/>
                            <field name="age" readonly="1"/>
                            <field name="gender"/>
                        </group>
                        <group string="Contact Info">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <group>
                        <group string="Academic Info">
                            <field name="department_id"/>
                            <field name="subject_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Teacher -->
    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">student.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first teacher!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_teacher"
              name="Teachers"
              parent="menu_student_management_root"
              action="action_teacher"
              sequence="15"/>

</odoo>
