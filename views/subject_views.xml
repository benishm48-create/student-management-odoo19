<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View for Subject -->
    <record id="view_student_subject_list" model="ir.ui.view">
        <field name="name">student.subject.list</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View for Subject -->
    <record id="view_student_subject_form" model="ir.ui.view">
        <field name="name">student.subject.form</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Mathematics"/></h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Subjects -->
    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">student.subject</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subject!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_subject"
              name="Subjects"
              parent="menu_student_management_root"
              action="action_subject"
              sequence="30"/>

</odoo>