<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View for Semester -->
    <record id="view_student_semester_list" model="ir.ui.view">
        <field name="name">student.semester.list</field>
        <field name="model">student.semester</field>
        <field name="arch" type="xml">
            <list string="Semesters">
                <field name="name"/>
                <field name="total_fee"/>
            </list>
        </field>
    </record>

    <!-- Form View for Semester -->
    <record id="view_student_semester_form" model="ir.ui.view">
        <field name="name">student.semester.form</field>
        <field name="model">student.semester</field>
        <field name="arch" type="xml">
            <form string="Semester">
                <sheet>
                    <div class="oe_title">
                        <h1>Semester Details</h1>
                    </div>

                    <group string="Semester Info">
                        <field name="name"/>
                        <field name="total_fee" readonly="1"/>
                    </group>

                    <group string="Fees">
                        <field name="fee_ids" widget="many2many" nolabel="1">
                            <list>
                                <field name="fee_type"/>
                                <field name="amount"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Semester -->
    <record id="action_semester" model="ir.actions.act_window">
        <field name="name">Semesters</field>
        <field name="res_model">student.semester</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first semester!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_semester"
              name="Semesters"
              parent="menu_student_management_root"
              action="action_semester"
              sequence="50"/>

</odoo>
