<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.html_container">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                
                <!-- CUSTOM STATIC HEADER -->
                <div class="header" style="font-family: Arial, sans-serif; font-size: 16px;">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; border-bottom: 1px solid #dee2e6;">
                        <tr>
                            <!-- Left: Logo Top, Text Directly Below -->
                            <td style="width: 50%; vertical-align: top; text-align: left; padding-bottom: 8px;">
                                <t t-if="doc.company_id.logo">
                                    <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 50px; display: block;" alt="Logo"/>
                                </t>
                                <div style="font-size: 18px; font-weight: bold; color: #1a365d; margin-top: 4px; display: block;">
                                    <span t-field="doc.company_id.name"/>
                                </div>
                                <div style="font-size: 14px; line-height: 1.3; color: #555;">
                                    <span t-field="doc.company_id.city"/> - <span t-field="doc.company_id.country_id.name"/>
                                </div>
                            </td>

                            <!-- Right: Quotation Details -->
                            <td style="width: 50%; vertical-align: top; text-align: right; padding-bottom: 8px;">
                                <h2 style="font-weight: bold; margin: 0 0 5px 0; color: #1a365d; font-size: 22px;">
                                    Quotation # <span t-field="doc.name"/>
                                </h2>
                                <div style="font-size: 15px; line-height: 1.4;">
                                    <div><strong>Quotation Date: </strong> <span t-field="doc.date_order" t-options='{"widget": "date"}'/></div>
                                    <div t-if="doc.validity_date"><strong>Expiration: </strong> <span t-field="doc.validity_date" t-options='{"widget": "date"}'/></div>
                                    <div t-if="doc.user_id"><strong>Salesperson: </strong> <span t-field="doc.user_id.name"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- PAGE BODY CONTENT -->
                <div class="article page" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.4; color: #212529;">
                    <div class="oe_structure"/>

                    <!-- Customer Section -->
                    <div class="row my-3" style="font-size: 16px;">
                        <div class="col-7 text-start">
                            <span class="text-muted small fw-bold" style="font-size: 13px; text-transform: uppercase;">To:</span>
                            <div class="fw-bold text-dark" style="font-size: 17px;" t-field="doc.partner_id.name"/>
                            <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' style="line-height: 1.3; font-size: 15px;"/>
                        </div>
                    </div>

                    <!-- Products Table -->
                    <table class="table table-bordered mb-3" style="border-color: #1a365d; font-size: 16px; width: 100%;">
                        <thead style="background-color: #1a365d; color: white;">
                            <tr class="text-center align-middle">
                                <th class="py-2 text-white" style="width: 6%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">SI No.</th>
                                <th class="py-2 text-white" style="width: 44%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">Item Description</th>
                                <th class="py-2 text-white" style="width: 10%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">Qty</th>
                                <th class="py-2 text-white" style="width: 14%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">Rate</th>
                                <th class="py-2 text-white" style="width: 10%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">Taxes</th>
                                <th class="py-2 text-white" style="width: 16%; color: #ffffff !important; font-size: 16px; background-color: #1a365d;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr class="align-middle">
                                    <td class="text-center py-2" style="font-size: 16px;"><t t-esc="i"/><t t-set="i" t-value="i+1"/></td>
                                    <td class="px-2 py-2" style="font-size: 16px;"><span t-field="line.name"/></td>
                                    <td class="text-center py-2" style="font-size: 16px;"><span t-field="line.product_uom_qty"/></td>
                                    <td class="text-end px-2 py-2" style="font-size: 16px;"><span t-field="line.price_unit"/></td>
                                    <td class="text-center py-2" style="font-size: 16px;">
                                        <span t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/>
                                    </td>
                                    <td class="text-end px-2 py-2" style="font-size: 16px;"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals Section -->
                    <div class="row mb-3" style="page-break-inside: avoid;">
                        <div class="col-5 ms-auto">
                            <table class="table table-bordered mb-0" style="font-size: 16px; width: 100%;">
                                <tr>
                                    <td class="p-2"><strong>Untaxed Amount</strong></td>
                                    <td class="text-end p-2"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td class="p-2"><strong>Tax</strong></td>
                                    <td class="text-end p-2"><span t-field="doc.amount_tax"/></td>
                                </tr>
                                <tr style="background-color: #1a365d !important; color: #ffffff !important;">
                                    <td class="p-2 text-white" style="color: #ffffff !important; font-size: 17px; background-color: #1a365d;"><strong>Grand Total</strong></td>
                                    <td class="text-end fw-bold p-2 text-white" style="color: #ffffff !important; font-size: 17px; background-color: #1a365d;"><span t-field="doc.amount_total"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Signatory -->
                    <div class="row mt-4" style="page-break-inside: avoid;">
                        <div class="col-5 text-center ms-auto">
                            <div class="fw-bold mb-1" style="font-size: 15px;">For <span t-field="doc.company_id.name"/></div>
                            <div class="border-top mt-4 pt-1 text-muted" style="font-size: 13px;">Authorised Signatory</div>
                        </div>
                    </div>
                </div>

                <!-- CUSTOM STATIC FOOTER -->
                <div class="footer text-center border-top pt-2" style="font-size: 13px; color: #444; font-family: Arial, sans-serif;">
                    <strong class="d-block text-uppercase" style="font-size: 14px; letter-spacing: 0.5px;">REGISTERED OFFICE ADDRESS</strong>
                    <div><span t-field="doc.company_id.street"/>, <span t-field="doc.company_id.city"/> - <span t-field="doc.company_id.zip"/></div>
                    <div class="fst-italic text-muted mt-1">Thank you for your business!</div>
                    <div class="text-end text-muted small" style="font-size: 11px;">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>