<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_student_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo() if 'company_id' in o and o.company_id else res_company"/>

                <!-- Custom Header: logo + college name on the same line -->
                <div class="header">
                    <table style="width:100%; border-bottom: 2px solid #714B67; padding-bottom: 8px;">
                        <tr>
                            <td style="width:70px; vertical-align:middle;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                     style="max-height:60px; max-width:70px;"/>
                            </td>
                            <td style="vertical-align:middle; padding-left:12px;">
                                <div style="font-size:18px; font-weight:bold; color:#333;">
                                    <span t-esc="company.name"/>
                                </div>
                                <div t-if="company.email or company.phone" style="font-size:10px; color:#777;">
                                    <span t-if="company.email" t-esc="company.email"/>
                                    <span t-if="company.email and company.phone"> | </span>
                                    <span t-if="company.phone" t-esc="company.phone"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Footer: repeats on every page -->
                <div class="footer">
                    <div style="border-top: 1px solid #ccc; padding-top: 6px; font-size: 9px; color: #777; text-align: center;">
                        <span t-esc="company.name"/>
                        <span t-if="company.phone"> | Phone: <span t-esc="company.phone"/></span>
                        <span t-if="company.email"> | Email: <span t-esc="company.email"/></span>
                        <span t-if="company.website"> | <span t-esc="company.website"/></span>
                        <div>
                            <span t-field="company.partner_id"
                                  t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                        </div>
                    </div>
                </div>

                <div class="article">
                    <div class="page" style="font-size: 12px; padding-top: 0;">

                        <table style="width:100%; margin-bottom: 18px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                            <tr>
                                <td style="vertical-align:middle; padding-bottom:10px;">
                                    <div style="font-size:22px; font-weight:bold; line-height:1.3;"><span t-field="o.name"/></div>
                                    <span class="badge text-bg-secondary" t-field="o.state"/>
                                </td>
                                <td style="width:100px; text-align:right; vertical-align:middle; padding-bottom:10px;">
                                    <img t-if="o.image" t-att-src="image_data_uri(o.image)"
                                         style="max-height:100px; max-width:100px; border-radius: 4px; border: 1px solid #ddd; display:block; margin-left:auto;"/>
                                </td>
                            </tr>
                        </table>

                        <h4 style="border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 20px;">Basic Info</h4>
                        <table style="width:100%; border-collapse: collapse; margin-bottom: 10px;">
                            <tr>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Age</td>
                                <td style="width:30%; padding:4px 0;"><span t-field="o.age"/></td>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Gender</td>
                                <td style="width:30%; padding:4px 0;"><span t-field="o.gender"/></td>
                            </tr>
                            <tr>
                                <td style="padding:4px 0; font-weight:bold;">Date of Birth</td>
                                <td style="padding:4px 0;"><span t-field="o.dob"/></td>
                                <td style="padding:4px 0; font-weight:bold;">Department</td>
                                <td style="padding:4px 0;"><span t-field="o.department_id.name"/></td>
                            </tr>
                        </table>

                        <h4 style="border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 20px;">Contact Info</h4>
                        <table style="width:100%; border-collapse: collapse; margin-bottom: 10px;">
                            <tr>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Phone</td>
                                <td style="width:30%; padding:4px 0;"><span t-field="o.phone"/></td>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Email</td>
                                <td style="width:30%; padding:4px 0;"><span t-field="o.email"/></td>
                            </tr>
                        </table>

                        <h4 style="border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 20px;">Academic Info</h4>
                        <table style="width:100%; border-collapse: collapse; margin-bottom: 10px;">
                            <tr>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Teacher</td>
                                <td style="width:30%; padding:4px 0;"><span t-field="o.teacher_id.name"/></td>
                                <td style="width:20%; padding:4px 0; font-weight:bold;">Subjects</td>
                                <td style="width:30%; padding:4px 0;">
                                    <t t-foreach="o.subject_ids" t-as="subj">
                                        <span t-field="subj.name"/><t t-if="not subj_last">, </t>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 0; font-weight:bold;">Overall Percentage</td>
                                <td style="padding:4px 0;"><span t-field="o.overall_percentage"/>%</td>
                                <td style="padding:4px 0; font-weight:bold;">Overall Grade</td>
                                <td style="padding:4px 0;"><span t-field="o.overall_grade"/></td>
                            </tr>
                        </table>

                        <t t-if="o.mark_ids">
                            <h4 style="border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 20px;">Marks</h4>
                            <table style="width:100%; border-collapse: collapse; margin-bottom: 10px;">
                                <thead>
                                    <tr style="background-color:#f2f2f2;">
                                        <th style="padding:6px; text-align:left; border:1px solid #ddd;">Subject</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Max Mark</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Obtained Mark</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Percentage</th>
                                        <th style="padding:6px; text-align:center; border:1px solid #ddd;">Grade</th>
                                        <th style="padding:6px; text-align:center; border:1px solid #ddd;">Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.mark_ids" t-as="mark">
                                        <td style="padding:6px; border:1px solid #ddd;"><span t-field="mark.subject_id.name"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="mark.max_mark"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="mark.obtained_mark"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="mark.percentage"/>%</td>
                                        <td style="padding:6px; text-align:center; border:1px solid #ddd;"><span t-field="mark.grade"/></td>
                                        <td style="padding:6px; text-align:center; border:1px solid #ddd;"><span t-field="mark.result"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.semester_fee_ids">
                            <h4 style="border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 20px;">Semester Fees</h4>
                            <table style="width:100%; border-collapse: collapse; margin-bottom: 10px;">
                                <thead>
                                    <tr style="background-color:#f2f2f2;">
                                        <th style="padding:6px; text-align:left; border:1px solid #ddd;">Semester</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Total Fee</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Discount</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Net Fee</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Paid</th>
                                        <th style="padding:6px; text-align:right; border:1px solid #ddd;">Balance</th>
                                        <th style="padding:6px; text-align:center; border:1px solid #ddd;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.semester_fee_ids" t-as="sem">
                                        <td style="padding:6px; border:1px solid #ddd;"><span t-field="sem.semester_id.name"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="sem.total_fee"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="sem.discount_percent"/>%</td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="sem.net_fee"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="sem.paid_amount"/></td>
                                        <td style="padding:6px; text-align:right; border:1px solid #ddd;"><span t-field="sem.balance"/></td>
                                        <td style="padding:6px; text-align:center; border:1px solid #ddd;"><span t-field="sem.payment_status"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_student_report" model="report.paperformat">
        <field name="name">Student Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">22</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">18</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_student" model="ir.actions.report">
        <field name="name">Student Details</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">students_management.report_student_document</field>
        <field name="report_file">students_management.report_student_document</field>
        <field name="print_report_name">'Student - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_student_report"/>
    </record>

</odoo>
