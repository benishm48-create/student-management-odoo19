<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_send_email_wizard_form" model="ir.ui.view">
        <field name="name">student.send.email.wizard.form</field>
        <field name="model">student.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Email">
                <group>
                    <field name="recipient_email" string="To"/>
                    <field name="subject"/>
                </group>
                <group>
                    <field name="body" nolabel="1" placeholder="Type your message here..."/>
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Send Mail" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action that opens the wizard as a popup -->
    <record id="action_send_email_wizard" model="ir.actions.act_window">
        <field name="name">Send Email</field>
        <field name="res_model">student.send.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
